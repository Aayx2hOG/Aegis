generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
}

enum AlertMetric {
    CHANGE_1D
    CHANGE_7D
}

enum AlertDirection {
    BELOW
    ABOVE
}

enum ClusterName {
    DEVNET
    TESTNET
    MAINNET_BETA
    LOCAL
}

model ResearchRun {
    id            String   @id @default(cuid())
    walletAddress String?
    protocolSlug  String
    briefMarkdown String
    toolCalls     Json
    createdAt     DateTime @default(now())

    @@index([walletAddress, createdAt])
    @@index([protocolSlug, createdAt])
}

model AlertRule {
    id              String         @id @default(cuid())
    walletAddress   String
    protocolSlug    String
    metric          AlertMetric
    threshold       Float
    direction       AlertDirection
    enabled         Boolean        @default(true)
    lastTriggeredAt DateTime?
    createdAt       DateTime       @default(now())
    updatedAt       DateTime       @updatedAt
    events          AlertEvent[]

    @@index([walletAddress, enabled])
    @@index([protocolSlug])
}

model AlertEvent {
    id                 String         @id @default(cuid())
    ruleId             String
    walletAddress      String
    protocolSlug       String
    metric             AlertMetric
    threshold          Float
    direction          AlertDirection
    currentValue       Float
    // email-related fields removed
    summary            String?
    summaryGeneratedAt DateTime?
    triggeredAt        DateTime       @default(now())

    rule AlertRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

    @@index([walletAddress, triggeredAt])
    @@index([ruleId, triggeredAt])
}

model WalletProfile {
    walletAddress String   @id
    displayName   String?
    createdAt     DateTime @default(now())
    updatedAt     DateTime @updatedAt

    watchlistItems WatchlistItem[]

    @@index([createdAt])
}

model WatchlistItem {
    id            String      @id @default(cuid())
    walletAddress String
    cluster       ClusterName
    protocolSlug  String
    source        String      @default("app")
    createdAt     DateTime    @default(now())
    updatedAt     DateTime    @updatedAt

    wallet WalletProfile @relation(fields: [walletAddress], references: [walletAddress], onDelete: Cascade)

    @@unique([walletAddress, cluster, protocolSlug])
    @@index([walletAddress, cluster])
    @@index([protocolSlug, cluster])
}

model ProtocolSnapshot {
    id           String      @id @default(cuid())
    protocolSlug String
    cluster      ClusterName
    tvlUsd       Float?
    change1dPct  Float?
    change7dPct  Float?
    source       String      @default("defillama")
    capturedAt   DateTime    @default(now())

    @@index([protocolSlug, cluster, capturedAt])
    @@index([capturedAt])
}

enum NotificationChannelType {
    DISCORD
    TELEGRAM
}

enum NotificationStatus {
    PENDING
    SENT
    FAILED
}

model NotificationChannel {
    id            String                  @id @default(cuid())
    walletAddress String
    name          String?
    type          NotificationChannelType
    config        Json
    enabled       Boolean                 @default(true)
    createdAt     DateTime                @default(now())
    updatedAt     DateTime                @updatedAt

    logs NotificationLog[]

    @@index([walletAddress])
}

model NotificationLog {
    id        String             @id @default(cuid())
    eventId   String
    channelId String
    status    NotificationStatus @default(PENDING)
    error     String?
    sentAt    DateTime?
    createdAt DateTime           @default(now())

    channel NotificationChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

    @@unique([eventId, channelId])
    @@index([eventId])
    @@index([channelId])
}

model TestArtifact {
    id            String   @id @default(cuid())
    ruleId        String
    eventId       String
    walletAddress String
    protocolSlug  String
    createdAt     DateTime @default(now())

    @@index([createdAt])
    @@index([walletAddress])
}
