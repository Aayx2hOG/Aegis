# Core persistence (optional for guest/browser-only use)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/aegis?schema=public
# POSTGRES_PRISMA_URL=
# POSTGRES_URL=

# Wallet authentication and encrypted notification secrets
AEGIS_AUTH_SECRET=replace-with-a-long-random-secret
AEGIS_ENCRYPTION_KEY=replace-with-a-long-random-secret
AEGIS_REQUIRE_WALLET_AUTH=true

# Optional AI-generated research and alert explanations
AEGIS_RESEARCH_AI_ENABLED=false
AEGIS_ALERT_AI_SUMMARIES_ENABLED=false
GROQ_API_KEY=

# Optional market-data providers
HELIUS_API_KEY=
BIRDEYE_API_KEY=

# Optional Redis-backed workers and queues
REDIS_URL=redis://localhost:6379
UPSTASH_REST_URL=
UPSTASH_REST_TOKEN=
UPSTASH_WEBHOOK_SECRET=
NOTIFICATION_DELIVERY_CONCURRENCY=5
ALERT_EVALUATION_INTERVAL_MS=300000

# Scheduled task authentication
ALERT_CRON_SECRET=replace-with-a-random-secret
# CRON_SECRET=
TEST_CLEANUP_SECRET=replace-with-a-random-secret
TEST_ARTIFACT_TTL_MS=86400000

# Public application URL used by queue callbacks
APP_URL=http://localhost:3000

# Optional EVM RPC overrides
NEXT_PUBLIC_ETHEREUM_RPC=
NEXT_PUBLIC_ARBITRUM_RPC=
NEXT_PUBLIC_OPTIMISM_RPC=

# Optional Solana on-chain watchlist experiment
NEXT_PUBLIC_WATCHLIST_PROGRAM_ID=
NEXT_PUBLIC_WATCHLIST_PROGRAM_ID_DEVNET=
NEXT_PUBLIC_WATCHLIST_PROGRAM_ID_TESTNET=
NEXT_PUBLIC_WATCHLIST_PROGRAM_ID_MAINNET=

# Development/test-only endpoints; never enable casually in production
AEGIS_ENABLE_E2E_TEST_API=false
